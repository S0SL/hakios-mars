# HakiOS fragment: the Xiaomi Mi 11 Pro (mars) -- what is true of this device and of no other.
#
# Every phone driver of the common repository is left out until it has been made to work here: their addresses, pins and rails
# are the reference phone's (a POCO X5 Pro 5G), and a driver of another phone touching this one's registers is the last thing
# wanted on a first boot. Put one back with CONFIG_HAKIOS_<NAME>=y when its step works (docs/porting/index.md step 3), and take
# the "# CONFIG_HAKIOS_<NAME> is not set" line below out at the same time.
CONFIG_DEVICE="mars"
# The arguments whose only readers are left out below go with them, or `make mars_defconfig` stops and says which:
# touchscreen= is read by hakios.buttons.c and hakios.goodix.c alone, and neither is built.
# CONFIG_TOUCHSCREEN is not set
# CONFIG_HAKIOS_ADSP is not set
# CONFIG_HAKIOS_SPEAKER is not set
# CONFIG_HAKIOS_SOUND is not set
# CONFIG_HAKIOS_MIC is not set
# CONFIG_HAKIOS_BT is not set
# CONFIG_HAKIOS_CAMERA is not set
# CONFIG_HAKIOS_TORCH is not set
# CONFIG_HAKIOS_SOCINFO is not set
# CONFIG_HAKIOS_ADRENO is not set
# CONFIG_HAKIOS_HAPTIC is not set
# CONFIG_HAKIOS_GOODIX is not set
# CONFIG_HAKIOS_BUTTONS is not set
# CONFIG_HAKIOS_QMI is not set
# CONFIG_HAKIOS_MODEM is not set
# CONFIG_HAKIOS_BATTERY is not set
# CONFIG_HAKIOS_CPUFREQ is not set
# CONFIG_HAKIOS_THERMAL is not set
# CONFIG_HAKIOS_PMIC is not set
# CONFIG_HAKIOS_BATTGUARD is not set
CONFIG_HAKIOS_UFS=y
# CONFIG_HAKIOS_WIFI is not set

# The open profile until this phone's firmware has been pulled and checked (devices/mars/pull-firmware.sh, then
# `tools/hakios-config.py needs`): the same ten lines as configs/open.config in the common tree, so that this configuration
# loads nothing of the phone's. "device" makes every option that wants fw-*/ a hard requirement of the build.
CONFIG_FIRMWARE="none"
# CONFIG_GPU is not set
# CONFIG_ADSP is not set
# CONFIG_SOUND is not set
# CONFIG_MIC is not set
# CONFIG_WIFI is not set
# CONFIG_HAPTIC is not set
# CONFIG_CAM is not set
# CONFIG_MODEM is not set
# CONFIG_MODEM_AGAIN is not set
# CONFIG_MODEM_BUFFER is not set
