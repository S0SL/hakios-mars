# HakiOS fragment: the Qualcomm SM8350 family (Snapdragon 888, 888+; "lahaina") -- what is true of the SoC, whatever phone it is in.
#
# A new SoC layer starts with none of the kernel's drivers: every driver of the common repository was written for the reference
# phone's SC7280, and its addresses, clock controllers and sensor tables are that family's. Turn each one on here the day it
# works on a phone with this SoC -- and take the matching "# CONFIG_HAKIOS_<NAME> is not set" line out of the device's own
# fragment, because the device's fragment is read last and would turn it off again.
CONFIG_SOC="sm8350"
CONFIG_CPUS=8
CONFIG_BOOTCPU=7

# One at a time, in the order of docs/porting/index.md step 3 (the symbol each needs is at the end of its line):
#   1  CPUFREQ   the cores' clocks; GCC of SM8350, not SC7280's                         -> CONFIG_HAKIOS_CPUFREQ=y
#   1  THERMAL   the SoC's temperature sensors; the sensor table is SM8350's            -> CONFIG_HAKIOS_THERMAL=y
#   1  PMIC      the PMIC arbiter's blocks; PM8350, PM8350C and PMK8350 here            -> CONFIG_HAKIOS_PMIC=y
#   1  SOCINFO   the chip's identity from SMEM; hakios.socinfo.c already knows SM8350   -> CONFIG_HAKIOS_SOCINFO=y
#   2  BUTTONS   the power and volume keys through the PMIC                             -> CONFIG_HAKIOS_BUTTONS=y
#   3  UFS       the phone's storage, read only to begin with                           -> CONFIG_HAKIOS_UFS=y
#   4  ADRENO    the Adreno 660; needs fw-gpu/ (a660_gmu.bin, a660_sqe.fw, a660_zap.*)  -> CONFIG_HAKIOS_ADRENO=y
#   5  ADSP      the audio DSP; needs fw-audio/                                         -> CONFIG_HAKIOS_ADSP=y
