#!/bin/bash
set -eu
AUTH="USER:PASSWORD"
LAN="http://192.168.101.10:19798/dav/mi11"
SYS="/home/shen/hakios/userland/system.apfs"
BOOT="/tmp/xnu-oldfd-dyldprim.img"

echo "=== ensure boot image on WebDAV ==="
curl -fsS -u "$AUTH" -T "$BOOT" -w "boot http=%{http_code} up=%{size_upload}\n" \
  -o /tmp/up-boot2.txt "$LAN/xnu-oldfd-dyldprim.img"
cat /tmp/up-boot2.txt

echo "=== upload system.apfs via LAN ==="
curl -fsS -u "$AUTH" -T "$SYS" \
  -w "system http=%{http_code} up=%{size_upload} time=%{time_total} speed=%{speed_upload}\n" \
  -o /tmp/up-sys2.txt "$LAN/system.apfs"
cat /tmp/up-sys2.txt

echo "=== verify LAN HEAD ==="
curl -sSI -u "$AUTH" "$LAN/system.apfs" | head -n 20

echo "=== verify LAN PROPFIND ==="
curl -fsS -u "$AUTH" -X PROPFIND -H "Depth: 1" -o /tmp/lan-after.xml "$LAN/"
python3 - <<'PY'
import re
xml=open("/tmp/lan-after.xml").read()
for m in re.finditer(r"<[Dd]:href>([^<]+)</[Dd]:href>", xml):
    print("href", m.group(1))
for m in re.finditer(r"getcontentlength>(\d+)", xml):
    print("size", m.group(1))
PY

echo "=== verify public HEAD ==="
curl -sSI -u "$AUTH" --max-time 30 "https://WEBDAV_HOST/dav/mi11/system.apfs" | head -n 20
